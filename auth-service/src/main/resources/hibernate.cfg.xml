<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Conexión a la base de datos -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <!-- ACTUALIZAR CON LA IP DEL MASTER DE DEV 2 -->
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/bd_banco</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">luvbeen265</property>
        <property name="hibernate.connection.pool_size">20</property>

        <!-- Propiedades de Hibernate -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.use_sql_comments">true</property>
        <property name="hibernate.jdbc.batch_size">20</property>
        <property name="hibernate.order_inserts">true</property>
        <property name="hibernate.order_updates">true</property>

        <!-- Estrategia de generación de DDL -->
        <property name="hibernate.hbm2ddl.auto">none</property>

        <!-- Clases mapeadas (Entidades JPA) -->
        <mapping class="banksoft.model.Usuario"/>
        <mapping class="banksoft.model.CuentaBancaria"/>
        <mapping class="banksoft.model.CodigoPostal"/>
        <mapping class="banksoft.model.Cliente"/>

        

    </session-factory>
</hibernate-configuration>
